# Python
__pycache__/
*.py[cod]
*.so
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Build and packaging
build/
dist/
*.egg-info/

# Node (the dashboard in web/; `dist/` is already ignored above)
node_modules/
*.tsbuildinfo

# IDE
.vscode/
.idea/

# Local env and secrets
.env
.env.*
.local/

# Runtime artifacts
.agentm/
.runs/
logs/
outputs/
*.log
artifacts/agent_*/
artifacts/areal_*/
artifacts/checkpoints/*
artifacts/predictions/*
artifacts/traces/*
artifacts/eval/*
artifacts/exported_model/*
artifacts/metadata/*.env
artifacts/metadata/*.json
!artifacts/**/.gitkeep

# Local corpora. `datapacks/ops-lite` is 7.4G of telemetry plus its annotation;
# it is a working copy, reproduced by copying the release and running
# `python -m autorl.dataset`, not something the history should carry.
datapacks/

# Local datasets and sample manifests
data/processed/*
!data/processed/.gitkeep
data/manifests/**/*.jsonl
data/manifests/*.jsonl

# Submodule / external envs
third_party/AReaL/.venv/
third_party/AReaL/.cache/

# SkyPilot and local orchestration files
.sky/
.omx/
