{
  "name": "@rca-autorl/dsh-rca-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness bundle for the RCA agent: a bounded DuckDB sql tool over the incident snapshot, a persistent investigation notebook, and terminal FPG submission.",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./compaction": "./src/compaction.js",
    "./pruner": "./src/pruner.js"
  },
  "files": [
    "src",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/dsh-compaction-basic": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "*"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.4.0-r.2"
  }
}
